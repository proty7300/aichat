# ============================================================
# AI Chat Web — Environment Variables
# Copy file ini jadi .env.local dan isi key yang kamu punya
# ============================================================

# OpenAI (GPT-4o, DALL-E 3, o1)
OPENAI_API_KEY=

# Anthropic (Claude Sonnet, Opus)
ANTHROPIC_API_KEY=

# Google (Gemini 2.5 Pro, Flash, Imagen)
GOOGLE_API_KEY=

# DeepSeek (V3, R1)
DEEPSEEK_API_KEY=

# Minimax (video, chat)
MINIMAX_API_KEY=

# Mistral
MISTRAL_API_KEY=

# General Compute (DeepSeek V3.2, V3.1, MiniMax M2.7)
GENERAL_COMPUTE_API_KEY=
GENERAL_COMPUTE_BASE_URL=https://api.generalcompute.com/

# Freemodel - Claude endpoint
FREEMODEL_CLAUDE_API_KEY=
FREEMODEL_CLAUDE_BASE_URL=https://cc.freemodel.dev

# Freemodel - OpenAI endpoint
FREEMODEL_OPENAI_API_KEY=
FREEMODEL_OPENAI_BASE_URL=https://api.freemodel.dev

# Cerebras (Claude, OpenAI compatible)
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# ============================================================
# CATATAN PENTING:
# - File .env.local TIDAK boleh di-commit ke GitHub
# - .env.example ini BOLEH di-commit (tidak ada key asli)
# - Di Vercel: isi key di Settings > Environment Variables
# ============================================================
